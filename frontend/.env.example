# Frontend build-time configuration (Vite).
# Copy to `.env` before `npm run build`. Values are inlined into the bundle,
# so changing them requires a rebuild (not just a restart).

# Base URL of the FastAPI backend. No trailing slash.
# Local:      http://localhost:8000
# Production: https://api.example.com
VITE_API_BASE_URL=http://localhost:8000

# Local-only visual QA without a backend. Leave false/omitted in deployment.
# Requires frontend/src/mock/mockApi.ts (gitignored).
VITE_MOCK_MODE=false
