# Backend environment variables.
# Copy to `.env` and fill in secrets. Vars below with "Phase A" notes are
# latency-tuning knobs from docs/latency_phase_a_implementation_plan.md
# (steps 3, 4, 6) — validate each against the evals/ harness before relying
# on it in production, since they can affect retrieval/answer quality.

# --- Required secrets ---
GEMINI_API_KEY=
# SUPABASE_URL=
# SUPABASE_KEY=
# JWT_SECRET=

# --- Chat / answer generation model ---
GEMINI_MODEL_ID=gemini-2.5-flash
CHAT_MODEL_ID=gemini-2.5-flash

# --- Step 6: cheaper/faster model for query rewriting (config only) ---
# Rewrite only reformulates the query, not the final answer — a lighter
# model here shaves latency off one of the two sequential Gemini calls per
# chat message. Falls back to GEMINI_MODEL_ID if unset.
# Validate rewrite confidence/risk-flag rates on the eval set before
# relying on this in production.
QUERY_REWRITE_MODEL_ID=gemini-2.5-flash

# --- Step 3: embedding provider (config only) ---
# Default "google" calls the Gemini embeddings API on every retrieval
# (network round-trip). "local" uses sentence-transformers in-process
# (near-zero network latency) but requires re-embedding the existing note
# corpus with the same model so query/doc embeddings stay comparable —
# treat this as a data migration, not just a flag flip. Validate recall via
# evals/ before switching in production.
EMBEDDING_PROVIDER=google
# EMBEDDING_DIMENSIONS must match the vector(N) columns in
# phase4_pgvector.sql (currently 768). Change both and re-embed if you switch.
EMBEDDING_DIMENSIONS=768
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector backend ---
# pgvector is the only runtime vector store. Chroma remains an offline
# evaluation-only dependency (evals/), never part of the app runtime.

# --- Step 4: retrieval/rerank/rewrite thresholds (config only) ---
# Lower top_k / raise the rewrite-quality bar to reduce work on the
# critical path. Tune one at a time and re-run evals/ between changes so
# regressions are attributable to a single knob.
QUERY_RETRIEVAL_TOP_K=5
QUERY_REWRITE_MIN_QUERY_QUALITY=0.35
QUERY_REWRITE_MIN_CONFIDENCE=0.55
# Reranker is off by default. Set to "token_overlap" or "semantic" to enable.
# QUERY_RETRIEVAL_RERANKER=token_overlap
# QUERY_RETRIEVAL_RERANKER=semantic

# --- CORS ---
# Comma-separated browser origins allowed to call the API. Defaults to local
# dev origins; set to "*" only if you explicitly want an open wildcard.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Pipeline logging ---
# Raw prompt/response file logging is OFF by default because the log contains
# full note text. Set PROMPT_LOG_ENABLED=true for local debugging only.
PROMPT_LOG_ENABLED=false
# Directory for the Gemini prompt/pipeline trace log file. Leave unset to
# use the auto-detected backend/logs (or OS temp dir as fallback).
# PROMPT_LOG_DIR=

# --- Recall candidate scoring / question generation / scheduling ---
# Threshold is intentionally lower than the plan's 0.65: a first note has no
# related-note or interest signal, so 0.65 would reject every candidate.
RECALL_ELIGIBILITY_THRESHOLD=0.45
RECALL_MIN_CONFIDENCE=0.6
RECALL_W_IMPORTANCE=0.30
RECALL_W_MENTION=0.20
RECALL_W_RELATED=0.20
RECALL_W_RECENCY=0.15
RECALL_W_INTEREST=0.15
RECALL_MENTION_CAP=10
RECALL_RELATED_TARGET=3
RECALL_RECENCY_HALFLIFE_DAYS=30
# 0 = no per-note cap (the review queue is the limiter).
RECALL_MAX_ITEMS_PER_NOTE=0

RECALL_MAX_QUESTION_CHARS=240
RECALL_MAX_ANSWER_CHARS=600
RECALL_MIN_ANSWER_OVERLAP=0.3
RECALL_DUPLICATE_THRESHOLD=0.9
RECALL_GENERATION_ATTEMPTS=2

# Anki-style learning steps in minutes, then graduating/easy intervals in days.
RECALL_LEARNING_STEPS=1,10
RECALL_RELEARNING_STEPS=10
RECALL_GRADUATING_INTERVAL=1
RECALL_EASY_INTERVAL=4
RECALL_STARTING_EASINESS=2.5
RECALL_MIN_EASINESS=1.3
RECALL_EASY_BONUS=1.3
RECALL_HARD_MULTIPLIER=1.2
RECALL_INTERVAL_MODIFIER=1.0
RECALL_LAPSE_MULTIPLIER=0.0
RECALL_MAX_INTERVAL=36500
